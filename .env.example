# Copy this file to .env and add your key. Never commit .env.
OPENAI_API_KEY=

# Optional for public SAM2; required for gated SAM3 experiments.
HF_TOKEN=

# Image-input and Structured Outputs capable model.
OPENAI_MODEL=gpt-6.1-terra

# Local Apple Silicon naming model.
QWEN_MODEL=mlx-community/Qwen3.5-9B-MLX-4bit

# Naming evidence below this threshold requires review.
CONFIDENCE_THRESHOLD=0.7
