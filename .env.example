# Copy this file to .env and add your key.
OPENAI_API_KEY=

# Vision-capable model used by the pilot. Override as needed.
OPENAI_MODEL=gpt-6.1-terra

# Optional model servers used by the track-grounded automation path.
# DAM follows NVLabs' /chat/completions server contract.
DAM_BASE_URL=

# SAM3 is expected to expose POST /redetect with text-prompt masks.
SAM3_BASE_URL=
